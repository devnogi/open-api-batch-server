# Synthetic local defaults only. Copy to .env.local; never use in production.
SERVER_PORT=8092
DB_IP=mysql
DB_PORT=3306
DB_SCHEMA=devnogi
DB_USER=devnogi
DB_PASSWORD=local-only-password
DB_ROOT_PASSWORD=local-only-root-password
MYSQL_EXTERNAL_PORT=3318
REDIS_HOST=redis
REDIS_PORT=6389
REDIS_EXTERNAL_PORT=6389
REDIS_PASSWORD=local-only-redis-password
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_INDEX_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9102
NEXON_OPEN_API_KEY=
AUCTION_HISTORY_DELAY_MS=1000
AUCTION_HISTORY_CRON=-
AUCTION_HISTORY_MIN_PRICE_CRON=-
HORN_BUGLE_CRON=-
AUCTION_REALTIME_CRON=-
STATISTICS_PREVIOUS_DAY_CRON=-
APP_CACHE_WARMUP_ENABLED=false
JWT_SECRET_KEY=local-development-only-key-change-before-any-shared-use
JWT_ACCESS_TOKEN_VALIDITY=3600
JWT_REFRESH_TOKEN_VALIDITY=86400
